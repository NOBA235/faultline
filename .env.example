# Copy to .env (or run "npm run setup" to generate one with fresh random values).
# NEVER commit .env. It is listed in .gitignore.

# Required. 64 hex characters (32 bytes). Encrypts PayPal secrets in the database.
# If you lose or change it, stored secrets become unreadable and must be re-entered.
ENCRYPTION_KEY=

# Required. At least 32 characters. Signs the login cookie.
SESSION_SECRET=

# Required. At least 12 characters. The password for the FAULTLINE UI.
ADMIN_PASSWORD=

# Optional (defaults shown)
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/faultline.db
PAYPAL_TIMEOUT_MS=10000
# How long to wait for your application to answer a forwarded event (milliseconds)
FORWARD_TIMEOUT_MS=10000
# How long to wait after the last delivery before reading your state probe (milliseconds)
PROBE_SETTLE_MS=500
# The address your browser uses for Faultline (PayPal redirects the buyer back here).
# Defaults to http://HOST:PORT.
PUBLIC_BASE_URL=
# Set to true only when serving over HTTPS
COOKIE_SECURE=false
